  ],
  "fields": [
    {
      "fieldname": "source_event_key",
      "fieldtype": "Data",
      "label": "Unique Allocation Reference",
      "reqd": 0,
      "unique": 1,
      "in_list_view": 1,
      "description": "Generated by Club100; unique grant issuance and replay protection.",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "member",
      "fieldtype": "Link",
      "label": "Member",
      "options": "Club100 Member",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "wallet",
      "fieldtype": "Link",
      "label": "Wallet",
      "options": "Club100 Wallet",
      "read_only": 1
    },
    {
      "fieldname": "source_type",
      "fieldtype": "Select",
      "label": "Funding Source",
      "options": "Corporate\nReferral\nPromotion",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "corporate_pool",
      "fieldtype": "Link",
      "label": "Corporate Credit Pool",
      "options": "Club100 Corporate Credit Pool",
      "depends_on": "eval:doc.source_type==\"Corporate\"",
      "description": "Required. Allocation is validated against remaining verified pool funding."
    },
    {
      "fieldname": "corporate_customer",
      "fieldtype": "Link",
      "label": "Corporate Customer",
      "options": "Customer",
      "depends_on": "eval:doc.source_type==\"Corporate\"",
      "read_only": 1,
      "description": "Automatically inherited from funded corporate pool."
    },
    {
      "fieldname": "funding_reference",
      "fieldtype": "Data",
      "label": "Funding / Approval Reference",
      "description": "Corporate: inherited from pool. Promotion: automatically recorded for authorized Desk grant.",
      "read_only": 1
    },
    {
      "fieldname": "funding_verified",
      "fieldtype": "Check",
      "label": "Corporate Funding Verified by Admin",
      "default": 0,
      "depends_on": "eval:doc.source_type==\"Corporate\"",
      "description": "For corporate grants, verified against the selected funded pool; this checkbox alone cannot authorize new corporate credits.",
      "read_only": 1
    },
    {
      "fieldname": "referral_reward",
      "fieldtype": "Link",
      "label": "Referral Reward",
      "options": "Club100 Referral Reward",
      "depends_on": "eval:doc.source_type==\"Referral\"",
      "description": "Reserved for future settled referrals; referral wallet posting is disabled."
    },
    {
      "fieldname": "amount",
      "fieldtype": "Currency",
      "label": "Credit Amount (INR)",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "currency",
      "fieldtype": "Link",
      "label": "Currency",
      "options": "Currency",
      "default": "INR",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "valid_from",
      "fieldtype": "Date",
      "label": "Valid From",
      "default": "Today",
      "reqd": 1
    },
    {
      "fieldname": "validity_type",
      "fieldtype": "Select",
      "label": "Credit Validity",
      "options": "Expires On\nLifetime",
      "default": "Expires On",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "expires_on",
      "fieldtype": "Date",
      "label": "Expiry Date (Inclusive)",
      "depends_on": "eval:doc.validity_type==\"Expires On\"",
      "description": "This date is included; credit becomes unavailable the following day. Leave blank for Lifetime."
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Active\nRevoked",
      "default": "Active",
      "reqd": 1,
      "read_only": 0,
      "description": "Normally Active. Authorized staff may only change Promotion grants to Revoked; existing ledger entries are retained."
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "Internal Notes",
      "description": "Business reason for Promotion issuance (required); issuance history is immutable."
    },
    {
      "fieldname": "revocation_reason",
      "fieldtype": "Small Text",
      "label": "Revocation Reason",
      "read_only": 0,
      "depends_on": "eval:doc.source_type==\"Promotion\"",
      "description": "Required only when revoking; cannot change the original amount, dates or issuance reason."
    },
    {
      "fieldname": "revoked_by",
      "fieldtype": "Link",
      "label": "Revoked By",
      "read_only": 1,
      "depends_on": "eval:doc.source_type==\"Promotion\"",
      "options": "User"
    },
    {
      "fieldname": "revoked_on",
      "fieldtype": "Datetime",
      "label": "Revoked On",
      "read_only": 1,
      "depends_on": "eval:doc.source_type==\"Promotion\""
    }
  ],
  "index_web_pages_for_search": 0,
  "links": [],
  "module": "Club100 Core",
  "name": "Club100 Wallet Grant",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "report": 1,
      "export": 1,
      "create": 1,
      "write": 1,
      "delete": 0
    }
  ],
  "sort_field": "creation",
  "sort_order": "DESC",
  "states": [],
  "track_changes": 1,
  "title_field": "source_event_key",
  "description": "Immutable corporate/referral grants and directly issued Promotion discounts; authorized Promotion grants may be revoked with audit metadata. No per-grant approval DocType required."
