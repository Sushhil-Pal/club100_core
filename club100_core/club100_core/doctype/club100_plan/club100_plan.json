   "reqd": 1,
   "unique": 1
  },
  {
   "fieldname": "plan_code",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Plan Code",
   "reqd": 1,
   "unique": 1
  },
  {
   "fieldname": "delivery_type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Delivery Type",
   "options": "Recorded\nLive Online",
   "reqd": 1
  },
  {
   "default": "0",
   "fieldname": "max_session_capacity",
   "fieldtype": "Int",
   "label": "Max Session Capacity"
  },
  {
   "default": "0",
   "fieldname": "coach_led",
   "fieldtype": "Check",
   "label": "Coach Led"
  },
  {
   "default": "0",
   "fieldname": "enhanced_progress_review",
   "fieldtype": "Check",
   "label": "Enhanced Progress Review"
  },
  {
   "default": "Trainer Led",
   "fieldname": "assessment_mode",
   "fieldtype": "Select",
   "label": "Assessment Mode",
   "options": "Trainer Led\nSelf Assessment\nBoth",
   "reqd": 1
  },
  {
   "default": "0",
   "fieldname": "workout_access_after_minutes",
   "fieldtype": "Int",
   "label": "Workout Access After Session (Minutes)"
  },
  {
   "fieldname": "self_workouts_per_week",
   "fieldtype": "Int",
   "label": "Self Workouts Per Week",
