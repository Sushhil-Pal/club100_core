 "doctype": "DocType",
 "engine": "InnoDB",
 "field_order": [
  "plan_name",
  "plan_code",
  "delivery_type",
  "max_session_capacity",
  "coach_led",
  "enhanced_progress_review",
  "assessment_mode",
  "workout_access_after_minutes",
  "self_workouts_per_week",
