  },
  {
   "fieldname": "self_workout_cycle",
   "fieldtype": "Link",
   "label": "Self Workout Cycle",
   "options": "Club100 Self Workout Cycle",
   "description": "Active reusable ordered workout cycle for this Self plan."
  },
  {
   "fieldname": "short_description",
   "fieldtype": "Small Text",
   "label": "Short Description"
  },
  {
   "default": "0",
   "fieldname": "display_order",
   "fieldtype": "Int",
   "label": "Display Order"
  },
  {
   "default": "1",
   "fieldname": "publish_to_website",
   "fieldtype": "Check",
   "label": "Publish to Website"
  },
  {
   "default": "Active",
   "fieldname": "status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Status",
   "options": "Active\nInactive",
   "reqd": 1
  }
 ],
 "grid_page_length": 50,
